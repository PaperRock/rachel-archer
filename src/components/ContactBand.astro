---
import { site } from "../data/site";
import Icon from "./Icon.astro";
import Section from "./Section.astro";

interface Props {
	heading?: string;
	sub?: string;
}

const {
	heading = "Let&rsquo;s talk",
	sub = "Whether you&rsquo;re not sure what&rsquo;s troubling you or ready to book, I&rsquo;m happy to talk it through &mdash; " +
		site.replyPromise,
} = Astro.props;
---

<Section>
	<div class="cta-band">
		<div>
			<h2 set:html={heading} />
			<p set:html={sub} />
		</div>
		<div class="cta-actions">
			<a class="btn btn-on-dark" href="/contact">
				<Icon name="speech" size={16} />
				Get in touch
			</a>
		</div>
	</div>
</Section>
