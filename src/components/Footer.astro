---
import { site } from "../data/site";
import Icon from "./Icon.astro";
---

<footer class="site-footer" transition:persist>
	<div class="container">
		<div class="footer-grid">
			<div class="footer-brand">
				<a class="wordmark" href="/" aria-label="Rachel Archer Counselling — home">
					<span class="wordmark-name">Rachel Archer</span>
					<span class="wordmark-sub">Counselling in Maidstone</span>
				</a>
				<p class="footer-note">
					{site.subtagline}. A warm, individual practice for adults &mdash; in person
					in Maidstone or online.
				</p>
				<div class="social-row">
					<a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Rachel Archer on Instagram">
						<Icon name="instagram" size={18} />
					</a>
					<a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Rachel Archer on Facebook">
						<Icon name="facebook" size={18} />
					</a>
				</div>
			</div>

			<div class="footer-col">
				<h4>Practice</h4>
				<ul>
					<li>{site.address.line1}</li>
					<li>{site.address.line2}, {site.address.postcode}</li>
					<li>United Kingdom</li>
				</ul>
			</div>

			<div class="footer-col">
				<h4>Contact</h4>
				<ul>
					<li><a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></li>
					<li><a href={`mailto:${site.email}`}>{site.email}</a></li>
				</ul>
			</div>

			<div class="footer-col">
				<h4>Professional</h4>
				<p>
					<a href={site.bacp.url} target="_blank" rel="noopener">
						{site.bacp.label}
					</a>
					{site.bacp.framework}
				</p>
				<div class="trust-row" style="margin-top: var(--space-5)">
					<a class="bacp-mark" href={site.bacp.url} target="_blank" rel="noopener" aria-label="Visit the BACP website">
						<img src="/images/bacp-logo.png" alt="BACP — British Association for Counselling and Psychotherapy" width="208" height="92" />
					</a>
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<span>&copy;{new Date().getFullYear()} by Rachel Archer.</span>
			<a href={site.privacyPolicy}>Privacy policy</a>
			<a href={`mailto:${site.email}`}>{site.email}</a>
			<span>Maidstone, United Kingdom</span>
		</div>
	</div>
</footer>
