---
import { emphasizeTitle } from "../lib/emphasis";
import { site } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
	title: string;
	intro: string;
	trust: string[];
}

const { title, intro, trust } = Astro.props;

const titleHtml = emphasizeTitle(title);
---

<section class="hero">
	<div class="container">
		<div class="hero-grid">
			<div class="hero-content">
				<h1 set:html={titleHtml} />

				<p class="hero-sub">{site.subtagline}</p>

				<p class="hero-intro">{intro}</p>

				<div class="hero-actions">
					<a class="btn btn-primary" href="/contact">
						<Icon name="speech" size={16} />
						Let&rsquo;s talk
					</a>
					<a class="btn btn-ghost" href={`tel:${site.phoneTel}`}>
						<Icon name="phone" size={16} />
						Call {site.phoneDisplay}
					</a>
				</div>

				<p class="hero-trust">
					<span>{site.bacp.label}</span>
					{trust.map((item) => (
						<>
							<span class="dot" aria-hidden="true">&bull;</span>
							<span>{item}</span>
						</>
					))}
				</p>
			</div>

			<div class="hero-media">
				<div class="frame">
					<img
						src="/images/rachel-archer.jpg"
						alt="Rachel Archer, counsellor in Maidstone"
						width="1000"
						height="1500"
						fetchpriority="high"
					/>
				</div>
				<span class="hero-loc">
					<Icon name="location" size={14} />
					{site.addressLine}
				</span>
			</div>
		</div>
	</div>
</section>
