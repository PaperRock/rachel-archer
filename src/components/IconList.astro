---
import Icon, { type IconName } from "./Icon.astro";

interface Props {
	items: Array<{ label: string; icon: IconName }>;
	label?: string;
}

const { items, label } = Astro.props;
---

<ul class="issues" aria-label={label}>
	{items.map((item) => (
		<li>
			<Icon name={item.icon} />
			<span>{item.label}</span>
		</li>
	))}
</ul>
