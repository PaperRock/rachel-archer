---
import { emphasizeTitle } from "../lib/emphasis";

interface Props {
	title: string;
	lead?: string;
}

const { title, lead } = Astro.props;
---

<section class="page-hero">
	<div class="container">
		<h1 set:html={emphasizeTitle(title)} />
		{lead && <p class="lead page-lead" set:html={emphasizeTitle(lead)} />}
	</div>
</section>
