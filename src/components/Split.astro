---
interface Props {
	stickyLeft?: boolean;
	wideLeft?: boolean;
}

const { stickyLeft = false, wideLeft = false } = Astro.props;

const classes = ["split", wideLeft ? "split-wide-left" : ""].filter(Boolean).join(" ");
---

<div class={classes}>
	<div class={stickyLeft ? "sticky-side" : undefined}>
		<slot name="left" />
	</div>
	<div>
		<slot name="right" />
	</div>
</div>
